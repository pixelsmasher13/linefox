# Apple Developer credentials for code signing + notarization.
# Copy this file to `.env.build` (gitignored) and fill in real values.
# `scripts/build-mac.sh` auto-loads `.env.build` if it exists.

# App Store Connect API key — get from
# https://appstoreconnect.apple.com/access/integrations/api
export APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
export APPLE_API_KEY=XXXXXXXXXX
export APPLE_API_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# Developer ID Application certificate — find with:
#   security find-identity -p basic -v
# Use the full common name, e.g.:
#   "Developer ID Application: Acme Inc. (TEAMID01AB)"
export APPLE_SIGNING_IDENTITY="Developer ID Application: YOUR TEAM (TEAMID)"

# Optional — override the release target (defaults to pixelsmasher13/linefox)
# export GH_REPO=youruser/linefox

# Optional — override the release tag (defaults to v$(version from Cargo.toml))
# export RELEASE_TAG=v0.0.2
